pipeline {
    agent any

    // 1. SCM Polling Trigger (Every 5 minutes)
    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout from SCM (Git) is automatic in Pipeline jobs if configured in the UI,
                // but explicit checkout is good practice if using a Jenkinsfile from SCM.
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                script {
                    echo 'Building Backend Docker Image...'
                    // Build the backend service using docker compose
                    sh 'cd cicd && docker compose build backend'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo 'Deploying Services...'
                    // Recreate the backend container (and others if changed)
                    // -d: Detached mode
                    // --no-deps: Don't restart dependent services (like nginx/postgres) unless necessary
                    // backend: Only target the backend service
                    sh 'cd cicd && docker compose up -d backend'
                    
                    // Optional: Prune old images to save space
                    sh 'docker image prune -f'
                }
            }
        }
    }
}
